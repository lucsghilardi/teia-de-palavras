# URL pública da API Laravel (usada como fallback e embutida no bundle em build).
NEXT_PUBLIC_API_URL=http://localhost:8005/api

# URL interna da API, resolvida só no servidor Next (proxy e rotas /api/auth).
# No compose de produção é o nginx do serviço backend: http://backend/api
# (o docker-compose.prod.yml já define; o .env.production não precisa repetir).
INTERNAL_API_URL=http://localhost:8005/api

# Laravel Reverb (WebSocket). Deixe APP_KEY vazio para desligar o tempo real —
# o painel segue funcionando só com polling. Deve ser igual ao REVERB_APP_KEY do backend.
NEXT_PUBLIC_REVERB_APP_KEY=

# Host onde o navegador conecta ao Reverb (sem esquema). Vazio = mesmo host do site.
NEXT_PUBLIC_REVERB_HOST=localhost

# Porta do Reverb (8080 em desenvolvimento; 443 atrás de um proxy TLS).
NEXT_PUBLIC_REVERB_PORT=8080

# "http" em desenvolvimento local, "https" em produção (força wss).
NEXT_PUBLIC_REVERB_SCHEME=http
