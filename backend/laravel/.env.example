APP_NAME="Teia de Palavras"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8005

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco (PostgreSQL no docker compose). DB_HOST=postgres é o nome do serviço.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=teia
DB_USERNAME=teia
DB_PASSWORD=secret

# Consumidas pelo CONTAINER postgres via env_file (mesmos valores acima).
POSTGRES_DB=teia
POSTGRES_USER=teia
POSTGRES_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Origem do frontend (CORS). Em dev o Next fala com a API pelo proxy interno,
# então isto só importa para chamadas diretas do navegador.
FRONTEND_URL=http://localhost:3005

# JWT (tymon/jwt-auth) — gere com: php artisan jwt:secret
JWT_SECRET=
# Adulto: 60 min (renovado pelo proxy). Criança: 480 min (8 h), para não cair
# no meio de uma sessão de aula.
JWT_TTL=60
JWT_CRIANCA_TTL=480

# Administrador inicial (criado pela migration de seed). Senha: 12+ caracteres.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tempo real (Laravel Reverb). Gere as credenciais com:
#   php -r "echo bin2hex(random_bytes(10)), PHP_EOL;"
# REVERB_APP_KEY precisa ser IGUAL ao NEXT_PUBLIC_REVERB_APP_KEY do frontend.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Como o Laravel alcança o servidor Reverb (rede interna do compose).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Onde o servidor Reverb escuta dentro do container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Origens aceitas pelo Reverb: só o HOST, sem esquema nem porta (vírgula).
# Em prod, o domínio do site (ex.: teia.exemplo.com.br).
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Mini-aulas gravadas pelas crianças (ensino entre pares): teto por criança e
# por dia, duração máxima do áudio e tamanho máximo do arquivo.
TEIA_MINI_AULAS_POR_DIA=10
TEIA_MINI_AULAS_DURACAO_MAX_S=60
TEIA_MINI_AULAS_TAMANHO_MAX_KB=2048
